load("@aspect_rules_lint//format:defs.bzl", "format_multirun", "format_test")
load("@rust_metadata//:edition.bzl", "RUST_EDITION")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "starlark",
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
)

format_multirun(
    name = "format",
    go = "@aspect_rules_lint//format:gofumpt",
    markdown = "@rumdl//:rumdl",
    markdown_check_args = [
        "fmt",
        "--check",
    ],
    markdown_fix_args = ["fmt"],
    rust = "@rules_rust//tools/upstream_wrapper:rustfmt",
    rust_check_args = [
        "--edition",
        RUST_EDITION,
        "--check",
    ],
    rust_fix_args = [
        "--edition",
        RUST_EDITION,
    ],
    shell = "@shfmt//:shfmt",
    shell_check_args = [
        "--diff",
        "--apply-ignore",
        "-i",
        "2",
        "-ci",
    ],
    shell_fix_args = [
        "-w",
        "--apply-ignore",
        "-i",
        "2",
        "-ci",
    ],
    starlark = "@buildifier//:buildifier",
)

format_test(
    name = "buildifier_format_test",
    size = "small",
    no_sandbox = True,
    starlark = "@buildifier//:buildifier",
    tags = ["local"],
    workspace = "//:MODULE.bazel",
)
